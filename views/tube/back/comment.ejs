<% console.log(`isArray(cm.contents.contents): ${Array.isArray(cm.contents.contents)}`);
  console.log(`isArray(cm.contents): ${Array.isArray(cm.contents)}`);
  (Array.isArray(cm.contents.contents) ? cm.contents.contents : cm.contents).forEach(thread => { 
  const comment = Array.isArray(thread.comment) 
    ? thread.comment[0] 
    : (thread.comment || thread);
  if (!comment || !comment.author) return;
%>
<div class="flex items-start bg-gray-700 p-4 rounded-lg transition-transform transform hover:scale-101">
  <img  
    loading="lazy"
    src="<%= comment.author.thumbnails?.[0]?.url || comment.authorThumbnails?.[0]?.url || ((comment.author?.id || comment.authorId) ? ('/tkt/back/c/' + (comment.author?.id || comment.authorId)) : '/default_avatar.png') %>"
    class="w-10 h-10 rounded-full"
  />
  <div class="ml-3 w-full">
    <p class="text-lg font-semibold">
      <a
        href="/tkt/c/<%= comment.author.id || comment.authorId %>"
        target="_blank"
        class="<%= comment.authorIsChannelOwner ? 'text-yellow-400 hover:underline' : comment.isSponsor ? 'text-green-400 hover:underline' : 'text-blue-400 hover:underline' %>"
      >
        <%= comment.author.name || comment.author %>
      </a>
      <% if (comment.isSponsor) { %>
        <img
          loading="lazy"
          src="<%= comment.sponsorIconUrl || 'null' %>"
          class="inline-block align-middle w-5 h-5"
        />
      <% } %>
      <span style="font-weight: normal;">
         <%= comment.published_time || comment.publishedText %>
      </span>
      <% if (comment.creatorHeart) { %>
        <img
          loading="lazy"
          src="<%= comment.creatorHeart.creatorThumbnail || 'null' %>"
          class="inline-block align-middle w-5 h-5"
        />
      <% } %>
    </p>

    <p class="text-gray-300 text-lg mt-1">
      <% if (comment.content?.runs) { %>
        <% comment.content.runs.forEach(run => { %>
          <% if (run.text && !run.emoji) { %>
            <%- run.text.replace(/\n/g, "<br />") %>
            <% } else if (run.emoji) { %>
              <%
                if (run.text.startsWith(":_")) {
                  const emojiData = cm.contents.header.custom_emojis.find(e => e.shortcuts.includes(run.text));
                  let url;
                  if (emojiData && emojiData.image.length > 0) {
                    url = emojiData.image.find(img => img.width === 48)?.url || emojiData.image[0].url;
                  } %>
                  <img src="<%= url %>" alt="<%= emojiData %>" class="inline-block w-6 h-6 align-text-bottom" />
                <% } else { %>
                  <span><%= run.text %></span>
                <% } %>
            <% } %>
          <% }) %>
        <% } else { %>
          <%- comment.contentHtml %>
        <% } %>
    </p>
    <br>
    <p><%= comment.like_count_a11y || comment.likeCount + "件の高評価" %></p>

  </div>
</div>
<% }); %>
