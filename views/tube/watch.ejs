    <script src="/js/eruda.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
    <script>
      const video = document.getElementById("video");
      const streamUrl = "<%- videoData.stream_url[0] %>";
      const streamUrl2 = "<%- videoData.stream_url[1] %>";
      const liveNow = '<%= videoData.liveNow == "true" ? "true" : "false" %>';
      const videoSrc = document.getElementById("videoSrc");
      const videoSrc2 = document.getElementById("videoSrc2");

      async function videoReload() {
        try{
          const res = await fetch(`/tkt/watch/streams/${videoId}`, { method: "GET" });
          const Data = await res.json();
          videoSrc.src = Data.stream_url[0];
          videoSrc2.src = Data.stream_url[1];
        } catch (e) {
          showerrorMessage(`ストリームURLの再取得に失敗しました: ${e.message}`);
        }
      }

      /*if (liveNow == "true" && streamUrl) {
        if (Hls.isSupported()) {
          const hls = new Hls({
            enableWorker: true,
            lowLatencyMode: true
          });

          hls.loadSource(streamUrl);
          hls.attachMedia(video);

          hls.on(Hls.Events.ERROR, (event, data) => {
            showerrorMessage(`HLS error: ${data}`);
          });
        } else if (video.canPlayType("application/vnd.apple.mpegurl")) {
          // Safari
          video.src = streamUrl;
        }
      }*/

      // コメント
      const commentContainers = [
        document.getElementById("commentsList1"),
        document.getElementById("commentsList2"),
      ];
      const errorContainers = [
        document.getElementById("commentError1"),
        document.getElementById("commentError2"),
      ];
      const retryButton = document.getElementById("retryButton");

      document
        .getElementById("closeComments")
        .addEventListener("click", closeComments);
      document
        .getElementById("closeComments2")
        .addEventListener("click", closeComments);
      document
        .getElementById("toggleComments")
        .addEventListener("click", toggleComments);

      function closeComments() {
        document.getElementById("commentBox").classList.remove("open");
      }
      function toggleComments() {
        document.getElementById("commentBox").classList.toggle("open");
      }

      async function fetchComments() {
        commentContainers.forEach(
          container => container.innerHTML = "<p>コメントを取得中...</p>"
        );
        errorContainers.forEach(error => error.style.display = "none");
        retryButton.style.display = "none";

        try {
          const response = await fetch("/tkt/back/comment/<%= videoId %>");
          if (!response.ok) throw new Error("サーバーエラー");

          const responseText = await response.text();
          commentContainers.forEach(
            container => container.innerHTML = responseText
          );
        } catch (error) {
          console.error("エラー:", error);
          showerrorMessage("コメントの取得に失敗しました");
          errorContainers.forEach((errorContainer) => {
            errorContainer.textContent =
              "コメントの取得に失敗しました: " + error.message;
            errorContainer.style.display = "block";
          });
          retryButton.style.display = "block";
        }
      }

      document
        .getElementById("retryButton")
        .addEventListener("click", fetchComments);
      fetchComments();

      //ループ
      const loopToggle = document.getElementById("loopToggle");
      const isLoop = localStorage.getItem("videoLoop") === "true";
      loopToggle.checked = isLoop;
      video.loop = isLoop;
      loopToggle.addEventListener("change", function () {
        video.loop = this.checked;
        localStorage.setItem("videoLoop", this.checked);
      });

      //自動再生
      const autoToggle = document.getElementById("autoToggle");
      const maxNameLength = 50;
      autoToggle.checked = localStorage.getItem("autoPlay") === "true";
      autoToggle.addEventListener("change", function () {
        localStorage.setItem("autoPlay", this.checked);
      });
      video.addEventListener("ended", () => {
        if (localStorage.getItem("autoPlay") === "true") playNextVideo();
      });
      function playNextVideo() {
        let nextVideoName = "<%= videoInfo.watch_next_feed?.[0]?.metadata?.title?.text || videoInfo.watch_next_feed?.[0]?.title?.text || '(動画名読み込みエラー)' %>";
        if ("<%= videoInfo.watch_next_feed?.[0]?._source %>" == "playlist") {
          if (nextVideoName.length > maxNameLength - 20) {
            nextVideoName = nextVideoName.slice(0, maxNameLength - 21) + "…";
          };
          let playlistName = "<%= videoInfo.watch_next_feed?.[0]?.playlistName %>";
          if (playlistName > maxNameLength - 30) {
            playlistName  = playName.slice(0, maxNameLength - 31) + "…";
          }
          showMessage(`再生中のプレイリスト｢${playlistName}｣の次の動画｢${nextVideoName}｣を再生します`);
        } else {
          if (nextVideoName.length > maxNameLength) {
            nextVideoName = nextVideoName.slice(0, maxNameLength - 1) + "…";
          };
          showMessage(`次の動画｢${nextVideoName}｣を再生します`);
        }
        setTimeout( () => {
          if ("<%= videoInfo.watch_next_feed?.[0]?._source %>" == "playlist") {
            location.href = "/tkt/watch/<%= videoInfo.watch_next_feed?.[0]?.content_id || videoInfo.watch_next_feed?.[0]?.id %>?playlist=<%= videoInfo.watch_next_feed?.[0]?.playlistId || 'error' %>";
          } else {
            location.href = "/tkt/watch/<%= videoInfo.watch_next_feed?.[0]?.content_id || videoInfo.watch_next_feed?.[0]?.id %>";
          }
        }, 100);
      };

      //動画再読み込み
      document
        .getElementById("reloadButton")
        .addEventListener("click", async function () {
          await videoReload();
          video.load();
        });
      document
        .getElementById("reloadVideo")
        .addEventListener("click", async function () {
          await videoReload();
          video.load();
        });

      //YouTubeリンクをコピー
      document
        .getElementById("linkCopyButton")
        .addEventListener("click", async function () {
          try {
            await navigator.clipboard.writeText("https://youtube.com/watch?v=<%= videoId %>");
            showMessage("YouTubeリンクをコピーしました");
          } catch (e) {
            showerrorMessage(`YouTubeリンクのコピーに失敗しました: ${e}`);
          }
        });

      //エラー処理
      video.addEventListener("error", function () {
        showerrorMessage(`動画の読み込みに失敗しました: ${error}`);
        let lastCurrentTime = video.currentTime;
        video.load();
        video.addEventListener(
          "loadedmetadata",
          function () {
            video.currentTime = lastCurrentTime;
            video.play();
          },
          { once: true }
        );
      });

      const errorReloadButton = document.getElementById("errorReloadButton");

