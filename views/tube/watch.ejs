<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= videoInfo.title %></title>
    <link rel="stylesheet" href="/css/page.css" />
    <script src="/js/tailwindcss.js"></script>
    <link
      rel="stylesheet"
      href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css"
    />
    <script src="https://code.jquery.com/jquery-3.5.1.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <script src="/js/tube.js"></script>
    <script src="/js/watch.js"></script>
    <link
      rel="apple-touch-icon"
      href="/tkt/back/vi/<%= videoId %>/maxresdefault.jpg"
    />
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        if (localStorage.getItem("sidebarHidden") === "true") {
          document.getElementById("sidebar").classList.add("hidden");
          document.getElementById("videoContainer").classList.add("full");
          document.getElementById("expandSidebar").classList.add("visible");
          document.getElementById("related-sidenone").classList.add("hidden");
        }
      });
    </script>
    <style>
      .comment-box,
      .related-box {
        transform: translateX(100%);
        transition: transform 0.2s ease-in-out;
      }
      .comment-box.open,
      .related-box.open {
        transform: translateX(0);
      }
      .main-container {
        display: flex;
        transition: width 0.2s ease-in-out;
      }
      .video-container {
        width: 75%;
        transition: width 0.2s ease-in-out;
      }
      .video-container.full {
        width: 100%;
      }
      .sidebar {
        width: 25%;
        transition: transform 0.2s ease-in-out;
      }
      .sidebar.hidden {
        transform: translateX(100%);
      }
      .related-sidenone {
        display: none;
      }
      .related-sidenone.hidden {
        display: block;
      }
      .expand-sidebar-btn {
        position: fixed;
        bottom: 20px;
        right: 10px;
        background: #444;
        color: white;
        padding: 10px 15px;
        border-radius: 5px;
        cursor: pointer;
        display: none;
      }
      .expand-sidebar-btn.visible {
        display: block;
      }
      .toolbar {
        position: fixed;
        top: 0;
        right: -50%;
        width: 50%;
        background: rgba(51, 51, 51, 0.95);
        transition: right 0.2s;
        padding: 20px;
        z-index: 10;
      }
      .toolbar.open {
        right: 0;
      }
      .toggle-btn {
        cursor: pointer;
        padding: 10px;
        background: #444;
        color: white;
        border: none;
        border-radius: 5px;
      }
      .checkbox-container {
        display: flex;
        align-items: center;
      }
      .controlPanel {
        display: none;
      }
      .controlPanel.open {
        display: block;
      }
      .tab-button.active {
        background-color: #4a5568;
      }
      .tab-content {
        display: none;
      }
      .tab-content.active {
        display: block;
      }
      .loading-indicator {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: none;
        z-index: 10;
      }
      .loading-indicator img {
        width: 75px;
        height: 75px;
      }
      .slide-text {
        position: relative;
        display: inline-flex;
        overflow: hidden;
        vertical-align: bottom;
      }
      .slide-inner {
        display: inline-block;
        white-space: nowrap;
      }
    </style>
  </head>
  <body class="bg-gray-900 text-white">
    <header class="bg-gray-800 p-4 flex justify-between items-center">
      <form action="/tkt/s" method="get" class="w-1/2 relative" id="searchForm">
        <input
          type="text"
          name="q"
          id="searchbox"
          placeholder="検索"
          class="searchbox w-full p-2 pr-10 rounded bg-gray-700 text-white"
        />
        <button
          type="button"
          id="clearBtn"
          class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center justify-center h-6 w-6 rounded-full hover:bg-gray-400 text-white text-lg leading-none hidden"
        >
          ×
        </button>
      </form>
      <button id="toggleToolbar" class="toggle-btn w-1/5">ツール</button>
    </header>

    <div class="toolbar w-1/2 ml-4" id="toolbar">
      <button
        id="closeToolbar"
        class="toggle-btn w-2/3 bg-gray-700 py-2 hover:text-white p-2 rounded mb-2 absolute top-4 right-4"
      >
        閉じる
      </button>
      <nav class="mt-12">
        <a
          href="/tkt"
          class="block w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2 text-center"
        >
          ホーム
        </a>
        <a
          href="/tkt/trend"
          class="block w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2 text-center"
        >
          トレンド
        </a>
        <a
          href="/tkt/cl/fav"
          class="block w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2 text-center"
        >
          お気に入り
        </a>
        <a
          href="/tkt/cl/history"
          class="block w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2 text-center"
        >
          履歴
        </a>
        <a
          href="/tkt/back/vi/<%= videoId %>/maxresdefault.jpg"
          download="<%= videoId %>_thumbnail.jpg"
          class="block w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2 text-center"
        >
          サムネをダウンロード
        </a>
        <a
          href="<%= videoData.stream_url[0] %>"
          class="block w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2 text-center"
        >
          ストリームURLを開く
        </a>
        <!--<a
          href="/tkt/download?url=<%- encodeURIComponent(videoData.stream_url) %>&title=<%- encodeURIComponent(videoInfo.title) %>&author=<%- encodeURIComponent(videoInfo.channelName) %>&date=<%- encodeURIComponent(videoInfo.published) %>&id=<%= videoId %>"
          class="block w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2 text-center"
        >
          動画をダウンロード
        </a>-->
      </nav>
      <div class="mt-4">
        <button
          id="reloadButton"
          class="w-full bg-gray-700 py-2 hover:text-white rounded mb-2"
        >
          動画を再読み込み
        </button>
        <button
          id="linkCopyButton"
          class="w-full bg-gray-700 py-2 hover:text-white rounded mb-2"
        >
          YouTubeリンクをコピー
        </button>
        <div
          class="checkbox-container w-full bg-gray-700 py-2 hover:text-white rounded mb-2 flex items-center justify-center"
        >
          <label for="loopToggle" class="ml-2">ループ再生</label>
          <input
            type="checkbox"
            id="loopToggle"
            class="form-checkbox text-green-500"
          />
        </div>
        <div
        class="checkbox-container w-full bg-gray-700 py-2 hover:text-white rounded mb-2 flex items-center justify-center"
      >
        <label for="autoToggle" class="ml-2">自動再生</label>
        <input
          type="checkbox"
          id="autoToggle"
          class="form-checkbox text-green-500"
        />
      </div>
        <% if (videoData.highstreamUrl) { %>
        <div
          class="checkbox-container mt-2 w-full bg-gray-700 py-2 hover:text-white rounded mb-2 flex items-center justify-center"
        >
          <label for="hdToggle" class="ml-2">高画質化</label>
          <input
            type="checkbox"
            id="hdToggle"
            class="form-checkbox text-green-500"
          />
        </div>
        <% } %>
      </div>
      <nav class="mt-4">
        <button
          onclick="window.location.href='/blog/b/tkthelp'"
          class="w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2"
        >
          ヘルプ
        </button>
      </nav>
    </div>

    <div class="max-w-6xl mx-auto p-4 main-container" id="mainContainer">
      <div class="video-container" id="videoContainer">
        <div class="relative">
          <div class="loading-indicator">
            <img
              src="/assets/loading.gif"
              alt="Loading..."
            />
          </div>
          <% if(pl == true) { %>
            <video
              id="video"
              class="w-full h-auto max-h-screen"
              controls
              preload="auto"
              playsinline
              poster="/tkt/back/vi/<%= videoId %>/maxresdefault.jpg"
              onloadedmetadata="checkPoster(this)"
              autoplay
            >
          <% } else { %>
            <video
              id="video"
              class="w-full h-auto max-h-screen"
              controls
              preload="auto"
              playsinline
              poster="/tkt/back/vi/<%= videoId %>/maxresdefault.jpg"
              onloadedmetadata="checkPoster(this)"
            >
          <% } %>
            <source
              id="videoSrc"
              src="<%- videoData.stream_url[0] %>"
              type="video/mp4"
            />
            <source
                id="videoSrc2"
                src="<%- videoData.stream_url[1] %>"
                type="video/mp4"
              />
          </video>
          <audio id="audio" style="display: none"></audio>
          <button
            id="errorReloadButton"
            class="hidden absolute top-1/2 left-1/2 z-50 -translate-x-1/2 -translate-y-1/2 bg-blue-600 text-white font-semibold py-2 px-4 rounded-xl shadow-lg hover:bg-blue-700 transition"
          >
            🔄 動画を再読み込み
          </button>
        </div>
        <div class="flex items-center mt-4 p-4 bg-gray-800 rounded">
          <a href="/tkt/c/<%= videoInfo.channelId %>">
            <img
              src="<%= videoInfo.channelIcon %>"
              alt="アイコン"
              class="w-12 h-12 rounded-full"
            />
          </a>
          <div class="ml-4">
            <h2 class="text-lg font-bold">
              <a href="/tkt/c/<%= videoInfo.channelId %>"
                ><%= videoInfo.channelName %></a
              >
            </h2>
            <p class="text-sm text-gray-400"><%= videoInfo.channelSubsc %></p>
          </div>
          <button id="favoriteBtn" class="ml-auto p-2 rounded-full bg-gray-500">
            <img
              id="favoriteIcon"
              src="/assets/favorite.png"
              alt="お気に入り"
              class="w-8 h-8"
            />
          </button>
        </div>

        <div class="mt-4 p-4 bg-gray-800 rounded">
          <div class="mt-2 text-gray-400 text-sm video-info">
            <span id="viewCount" class="slide-text"><span class="slide-inner"><%= videoInfo.viewCount %></span></span> ・ 
            <span id="likeCount" class="slide-text"><span class="slide-inner"><%= videoInfo.likeCount %>いいね</span></span> ・
            <span id="published" class="slide-text"><span class="slide-inner"><%= videoInfo.published %></span></span>
          </div>
          <div class="flex items-center justify-between">
            <h3 class="text-2xl font-bold">
              <%= videoInfo.title %>
            </h3>
            <button
              class="ml-2 text-blue-500 hover:text-blue-300 text-sm"
              onclick="toggleDescription(this)"
            >
              折りたたむ
            </button>
          </div>
          <%
          function normalizeYouTubeUrl(url) {
            try {
                const u = new URL(url);
        
                if (u.hostname === "www.youtube.com" && u.pathname === "/redirect" && u.searchParams.has("q")) {
                  return decodeURIComponent(u.searchParams.get("q"));
                } else if (u.hostname === "www.youtube.com" && u.pathname !== "/redirect"){
                  const uu = "/tkt" + url.slice(23, url.length).trim();
                  if (u.pathname.includes("/c") && !u.pathname.includes("@")) {
                    const u2 = uu.slice(0, 7).trim();
                    const u3 = uu.slice(7, uu.length).trim();
                    const uuu = u2 + "@" + u3;
                    return uuu;
                  } else {
                    return uu;
                  }
                }
        
                return url;
            } catch {
                return url;
            }
          }
          function renderDescription(description) {
            if (!description) return "";
    
            return description.map(run => {
                if (run.endpoint?.metadata?.url) {
                    let url = run.endpoint.metadata.url;
                    url = normalizeYouTubeUrl(url);
                    if (url.startsWith("/") || url.includes("www.youtube.com")) return `<a href="${url}" target="_self" rel="noopener noreferrer">${run.text}</a>`;
                    return `<a href="${url}" target="_blank" rel="noopener noreferrer">${run.text}</a>`;
                }
    
                return run.text
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/\n/g, "<br>");
            }).join("");
          } %>
          <div class="description mt-2">
            <% if (videoInfo.description) { %>
              <p class="text-base text-gray-300 mt-1">
                <%- renderDescription(videoInfo.description) %>
                <!--%- videoInfo.description.replace(/\n/g, '<br>') %-->
              </p>
            <% } else { %>
              <p class="text-base text-gray-300 mt-1" style="color: #aaa; font-style: italic;">
                この動画には説明がありません。
              </p>
            <% }; %>
          <!--
          <div class="description mt-2">
            <% if (videoData.videoDes) { %>
              <p class="text-base text-gray-300 mt-1">
                <%- videoData.videoDes.replace(/\n/g, "<br>") %>
              </p>
            <% } else { %>
              <p class="text-base text-gray-300 mt-1" style="color: #aaa; font-style: italic;">
                この動画には説明がありません。
              </p>
            <% }; %>-->
          </div>
        </div>

        <div class="mt-4 p-4 bg-gray-800 rounded">
          <h3 class="text-lg font-bold">コメント</h3>
          <div class="mt-2 space-y-2">
            <div id="commentError2" class="text-red-500 hidden"></div>
            <div id="commentsList2" class="mt-2 space-y-2">
              <p>コメントを取得中...</p>
            </div>
          </div>

          <button
            id="retryButton"
            class="w-full bg-gray-700 py-2 rounded mt-2 hidden"
          >
            再取得
          </button>
        </div>
        <div
          class="related-sidenone mt-4 p-4 bg-gray-800 rounded"
          id="related-sidenone"
        >
          <h3 class="text-lg font-bold">関連動画</h3>
          <br />
          <% if (videoInfo.watch_next_feed && videoInfo.watch_next_feed.length > 0) { %>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            <% videoInfo.watch_next_feed.forEach(video => { %> <% if
            (video.content_type == "VIDEO" || video.type.endsWith("Video") || video._source == "playlist") { %>
            <% if (video._source == "playlist") { %>
              <div class="result-item w-auto h-auto bg-gray-700 p-5 rounded" style="margin-bottom: 3em;">
                <p class="text-lg font-bold">再生中のプレイリスト｢<%= videoInfo.watch_next_feed[0].playlistName.length > 10 ? videoInfo.watch_next_feed[0].playlistName.slice(0, 9) + "…" : videoInfo.watch_next_feed[0].playlistName %>｣の次の動画</p>
                <a href="/tkt/watch/<%= video.content_id || video.id || 'error' %>?playlist=<%= video.playlistId %>" class="thumbnail">
            <% } else { %>
              <div class="result-item w-auto h-auto bg-gray-700 p-5 rounded">
                <a href="/tkt/watch/<%= video.content_id || video.id || 'error' %>" class="thumbnail">
            <% } %>
                <img
                  loading="lazy"
                  src="/tkt/back/vi/<%= video.content_id || video.id || 'error' %>/mqdefault.jpg"
                  alt="<%= video.metadata?.title?.text || video.title?.text || 'error' %>"
                  class="w-full h-auto rounded"
                />
                <span class="video-duration"><%
                  const duration =
                    video.content_image?.overlays
                      ?.find(o => o.badges?.[0]?.text)
                      ?.badges?.[0]?.text;
                  %>
                  
                  <%= duration || "error" %>
                </span>
              </a>
              <div class="mt-2 flex items-center">
                <a
                  href="/tkt/c/<%= video.metadata?.image?.renderer_context?.command_context?.on_tap?.payload?.browseId || video.author?.id || 'error' %>"
                  class="flex items-center"
                >
                <% const thumbUrl = video.metadata?.image?.avatar?.image?.[0]?.url || video.author?.thumbnails?.[0]?.url || "error" %>
                <% if (video._source == "playlist") { %>
                  <img
                    src="/tkt/back/c/<%= video.metadata?.image?.renderer_context?.command_context?.on_tap?.payload?.browseId || video.author?.id || 'error' %>"
                    alt="<%= video.metadata?.metadata?.metadata_rows?.[0]?.metadata_parts?.[0]?.text?.text || video.author.name || 'error' %> のアイコン"
                    class="w-8 h-8 rounded-full mr-2"
                  />
                <% } else { %>
                  <img
                  src="/tkt/back/yt3<%- thumbUrl == 'error' ? thumbUrl : (new URL(thumbUrl)).pathname %>"
                  alt="<%= video.metadata?.metadata?.metadata_rows?.[0]?.metadata_parts?.[0]?.text?.text || video.author.name || 'error' %> のアイコン"
                  class="w-8 h-8 rounded-full mr-2"
                />
                <% } %>
                  <p class="text-sm text-gray-400"><%= video.metadata?.metadata?.metadata_rows?.[0]?.metadata_parts?.[0]?.text?.text || video.author?.name || "error" %></p>
                </a>
              </div>
              <p class="text-lg font-bold"><%= video.metadata?.title?.text || video.title?.text || "error" %></p>
              <% if (video._source == "playlist") { %>
                <p class="text-xs text-gray-500">
                  <%= video.metadata?.metadata?.metadata_rows[1].metadata_parts[0].text?.text || video.view_count?.text || video.short_view_count?.text || video.video_info?.runs?.[0]?.text || "error" %> - <%= video.metadata?.metadata?.metadata_rows?.[1]?.metadata_parts?.[1]?.text?.text || video.published || video.video_info?.runs?.[2]?.text || "error" %>
                </p>
              <% } else { %>
                <p class="text-xs text-gray-500">
                  <%= video.metadata?.metadata?.metadata_rows[1].metadata_parts[0].text?.text || video.view_count?.text || video.short_view_count?.text || "error" %> - <%= video.metadata?.metadata?.metadata_rows?.[1]?.metadata_parts?.[1]?.text?.text || video.published || "error" %>
                </p>
              <% } %>
            </div>
            <% } else if (video.type.endsWith("Playlist") || video.content_type == "PLAYLIST") { %>
            <div class="result-item bg-gray-600 p-4 rounded">
              <a href="/tkt/p/<%= video.id || video.content_id || video.metadata?.metadata?.metadata_rows?.[5]?.metadata_parts?.[0]?.text?.runs?.[0]?.endpoint?.payload?.browseId || 'error' %>">
                <img
                  src="<%= video.content_image?.primary_thumbnail?.image?.[0]?.url || `/tkt/back/vi/${video?.endpoint?.payload?.videoId || video.first_videos[0]?.id}/mqdefault.jpg` || 'error' %>"
                  alt="<%= video.title || video.metadata?.title?.text || '不明なプレイリスト' %>"
                  class="w-full h-auto rounded"
                />
              </a>
              <div class="mt-2">
                <p class="text-sm text-gray-400">
                  <a href="/tkt/c/<%= video.author?.id || video.metadata?.metadata?.metadata_rows?.[0]?.metadata_parts?.[0]?.text?.runs?.[0]?.endpoint?.payload?.browseId || 'error' %>">
                    <%= video.author?.name || video.metadata?.metadata?.metadata_rows?.[0]?.metadata_parts?.[0]?.text?.text || 'チャンネル' %>
                  </a>
                </p>
                <p class="text-lg font-bold"><%= video.title || video.metadata?.title?.text || "不明なプレイリスト" %></p>
                <p class="text-xs text-gray-500">
                  <%= video.content_image?.primary_thumbnail?.overlays[0]?.badges[0].text || video.video_count?.text || "error" %>
                </p>
              </div>
            </div>
            <% } else if (video.type.endsWith("Channel")) { %>
            <div class="result-item bg-gray-600 p-4 rounded">
              <a href="/tkt/c/<%= video.author.id %>">
                <img
                  src="<%= video.author.thumbnails[0].url %>"
                  alt="<%= video.author.name %>"
                  class="w-full h-auto rounded"
                />
              </a>
              <div class="mt-2">
                <p class="text-lg font-bold"><%= video.author.name %></p>
                <p class="text-sm text-gray-400">
                  <%= video.description_snippet?.text %>
                </p>
                <p class="text-xs text-gray-500">
                  <%= video.subscriber_count?.text %> • <%= video.videos?.text
                  || video.video_count?.text %>
                </p>
              </div>
            </div>
            <% } %> <% }); %>
          </div>
          <% } %>
        </div>
      </div>

      <div
        id="controlPanel"
        class="controlPanel bg-gray-900 text-white p-6 rounded-lg shadow-lg w-96 fixed bottom-10 right-10 border border-gray-700"
      >
        <button
          id="closeControlPanel"
          class="absolute top-2 right-2 text-gray-400 hover:text-white text-2xl"
        >
          ×
        </button>
        <div class="tab-header flex border-b border-gray-700 mb-4">
          <div
            id="tabControl"
            class="tab-button active px-4 py-2 cursor-pointer text-white bg-gray-800 rounded-t-lg"
            data-target="controlTab"
          >
            コントロール
          </div>
          <div
            id="tabSettings"
            class="tab-button px-4 py-2 cursor-pointer text-gray-400 hover:text-white rounded-t-lg"
            data-target="settingsTab"
          >
            設定
          </div>
        </div>
        <div id="controlTab" class="tab-content active">
          <div class="control-section mb-4">
            <button
              id="reloadVideo"
              class="control-button w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2"
            >
              🔄 再読み込み
            </button>
          </div>
          <% if (videoData.streamUrls && videoData.streamUrls.length > 0) { %>
          <div class="control-section mb-4">
            <label class="block mb-2"
              >画質選択:
              <select
                id="qualitySelect"
                class="w-full bg-gray-800 text-white p-2 rounded"
              >
                <% videoData.streamUrls.forEach(stream => { %>
                <option
                  value="<%= stream.url %>"
                  data-resolution="<%= stream.resolution %>"
                >
                  <%= stream.resolution %>
                </option>
                <% }); %>
              </select>
            </label>
            <button
              id="qualityReset"
              class="control-button w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2"
            >
              画質をリセット
            </button>
          </div>
          <% } else { %>
          <p class="text-gray-400">他の画質が見つかりません</p>
          <% } %>
          <div class="control-section mb-4">
            <p class="block mb-2">
              使用したサーバー:
              <strong
                ><%= baseUrl.replace('https://', '').replace('.glitch.me', '')
                %></strong
              >
            </p>
            <label class="block mb-2"
              >サーバーを変える:
              <select
                id="serverSelect"
                class="w-full bg-gray-800 text-white p-2 rounded"
              >
                <option value="watawata8">watawata8</option>
                <option value="watawata37">watawata37</option>
                <option value="watawatawata">watawatawata</option>
                <option value="wataamee">wataamee</option>
                <option value="manawa">manawa</option>
                <option value="wakame02o">wakame02o</option>
                <option value="wakeup">wakeup</option>
                <option value="hortensia">hortensia</option>
