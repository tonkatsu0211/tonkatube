          "text-white",
          "p-5",
          "rounded-lg",
          "shadow-xl",
          "opacity-90",
          "z-50",
          "transform",
          "scale-90",
          "transition-transform",
          "border-2",
          "border-red-500"
        );
        alertMessage.innerHTML = `
        <div class="flex items-center justify-between space-x-4">
            <span class="font-semibold">⚠︎ ${text}</span>
            <button class="text-white hover:text-gray-300 focus:outline-none text-xl font-bold" aria-label="閉じる">&times;</button>
        </div>
    `;
        document.body.appendChild(alertMessage);
        const closeButton = alertMessage.querySelector("button");
        const autoRemoveTimer = setTimeout(() => {
          hideMessage(alertMessage);
        }, 3500);
        closeButton.addEventListener("click", () => {
          clearTimeout(autoRemoveTimer);
          hideMessage(alertMessage);
        });
        let startX = null;
        let currentX = 0;
        let moved = false;
        alertMessage.addEventListener("touchstart", (e) => {
          startX = e.touches[0].clientX;
          moved = false;
          alertMessage.style.transition = "none";
        });
        alertMessage.addEventListener("touchmove", (e) => {
          if (startX === null) return;
          const touch = e.touches[0];
          const deltaX = touch.clientX - startX;
          if (Math.abs(deltaX) > 5) moved = true;
          currentX = deltaX;
          alertMessage.style.transform = `translateX(${deltaX}px) scale(1)`;
        });
        alertMessage.addEventListener("touchend", () => {
          alertMessage.style.transition =
            "transform 0.3s ease, opacity 0.3s ease";
          if (moved && Math.abs(currentX) > 100) {
            alertMessage.style.opacity = "0";
            alertMessage.style.transform = `translateX(${
              currentX > 0 ? 500 : -500
            }px) scale(0.95)`;
            setTimeout(() => alertMessage.remove(), 300);
          } else {
            alertMessage.style.transform = "translateX(0) scale(1)";
          }
          startX = null;
          currentX = 0;
          moved = false;
        });
      }

      //情報更新
      function slideText(element, newText) {
        const old = element.querySelector(".slide-inner");
      
        // 初回
        if (!old) {
          const span = document.createElement("span");
          span.className = "slide-inner";
          span.textContent = newText;
          element.appendChild(span);
          return;
        }
      
        if (old.textContent === newText) return;
      
        const next = document.createElement("span");
        next.className = "slide-inner";
        next.textContent = newText;
      
        next.style.position = "absolute";
        next.style.left = "0";
        next.style.top = "100%";
      
        element.appendChild(next);
      
        requestAnimationFrame(() => {
          old.style.transition = "transform .2s cubic-bezier(.4,0,.2,1)";
          next.style.transition = "transform .2s cubic-bezier(.4,0,.2,1)";
      
          old.style.transform = "translateY(-100%)";
          next.style.transform = "translateY(-100%)";
        });
      
        next.addEventListener("transitionend", () => {
          old.remove();
      
          next.style.position = "";
          next.style.top = "";
          next.style.left = "";
          next.style.transform = "";
          next.style.transition = "";
      
          next.className = "slide-inner";
        }, { once: true });
      }
      
      setInterval(async () => {
        try{
          const res = await fetch("/api/updatevideoinfo/<%= videoId %>");
          const r = await res.json();
          const view = r.viewCount;
          const like = `${r.likeCount}高評価`;
          const pub = r.published.text;
          console.log(r);
          console.log(typeof r.published, r.published);
          console.log(`view:${view}, like:${like}, pub:${pub}`)
          const viewEl = document.getElementById("viewCount");
          const likeEl = document.getElementById("likeCount");
          const pubEl = document.getElementById("published");
          if (viewEl.textContent != view) slideText(viewEl, view);
          if (likeEl.textContent != like) slideText(likeEl, like);
          if (pubEl.textContent != pub) slideText(pubEl, pub);
        } catch (e) {
          console.log(e.message);
        }
      }, 30000);

      //eruda
      let useEruda = localStorage.getItem("eruda") || false;
      if (useEruda == "true") eruda.init();
      const isMac = /Mac|iPhone|iPad/.test(navigator.userAgent);
      document.addEventListener("keydown", (e) => {
        const mod = isMac ? e.metaKey : e.ctrlKey;
        if (mod && e.shiftKey && e.key == "i") {
          if (useEruda == "true") {
            localStorage.setItem("eruda", false);
            useEruda = "false";
            alert("eruda disabled");
          } else {
            localStorage.setItem("eruda", true);
            useEruda = "true";
            alert("eruda enabled");
            eruda.init();
          }
        }
      });
    </script>
  </body>
</html>
